# Build trees (canonical: build, build-asan, build-tsan — roadmap/README.md §1)
build/
build-*/

# CMake
Testing/
CMakeUserPresets.json

# Sample binaries (samples/hello builds into its own source-tree bin/ —
# the CI detcheck step invokes samples/hello/bin/hello from the repo
# root; M1-SAMPLE-01)
samples/*/bin/

# Compiled artifacts (in case they ever land outside build trees)
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Fuzzing / coverage artifacts
*.profraw
*.profdata
*.fuzz
coverage/

# Python artifacts (tools/ scripts)
__pycache__/
*.pyc

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.user
*.swp

# Local secrets — never committed, never shared (see .env.example template)
.env
.env.local
*.token

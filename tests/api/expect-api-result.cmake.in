# Generated by tests/api/CMakeLists.txt for one laige-api CTest test
# (M0-TOOL-01) — do not edit.
#
# Runs laige-api-scanner against one tree and asserts BOTH the exit code
# and the required output fragments (the needle checks below are
# generated per test). The assertions live here, in a CMake script,
# instead of in CTest properties: CTest inverts PASS_REGULAR_EXPRESSION
# when WILL_FAIL is set (verified on CMake 4.4.3 — a matching regex then
# makes the test fail), and a plain exit-code expectation would let a
# crash (also non-zero) masquerade as a correct scan failure.
#
# The script exits non-zero (failing the CTest test) on any mismatch and
# prints the full scanner output for diagnosis.

set(_cmd @CMD@)
execute_process(
  COMMAND @SCANNER@ ${_cmd}
  RESULT_VARIABLE _rc
  OUTPUT_VARIABLE _out
  ERROR_VARIABLE _err
)

set(_text "${_out}
${_err}")

set(_problems "")
if(NOT _rc EQUAL @EXPECT_EXIT@)
  set(_problems "exit code ${_rc} (expected @EXPECT_EXIT@)")
endif()
if(NOT "@EXPECTED_FILE@" STREQUAL "")
  # Byte comparison of the written manifest against the expected copy.
  file(READ "@EXPECTED_FILE@" _expected)
  file(READ "@OUT_FILE@" _actual)
  if(NOT _actual STREQUAL _expected)
    set(_problems "${_problems}manifest differs from expected bytes; ")
  endif()
endif()
@CHECKS@
if(NOT _problems STREQUAL "")
  message(FATAL_ERROR
    "laige-api check failed [${_problems}]\n"
    "--- scanner output ---\n${_text}\n--- end of scanner output ---")
endif()
message("laige-api check OK: exit @EXPECT_EXIT@, required output present")
